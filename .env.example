# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# TLS/SSL Configuration
TLS_ENABLED=false
TLS_KEY_PATH=./certs/server.key
TLS_CERT_PATH=./certs/server.cert

# WebSocket Configuration
WS_PORT=3001
WS_PING_INTERVAL=30000
WS_PING_TIMEOUT=5000

# Agent Configuration
AGENT_HEARTBEAT_INTERVAL=60000
AGENT_HEARTBEAT_TIMEOUT=120000
AGENT_MAX_CONNECTIONS=1000
AGENT_DISCOVERY_TTL=300000

# Command Configuration
COMMAND_TIMEOUT=30000
COMMAND_MAX_RETRIES=3
COMMAND_RETRY_DELAY=1000
COMMAND_QUEUE_MAX_SIZE=10000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Database (Optional - for persistent storage)
DB_TYPE=redis
DB_HOST=localhost
DB_PORT=6379
DB_PASSWORD=
DB_DATABASE=0

# Encryption
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY_DERIVATION=pbkdf2

# Monitoring
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Audit
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=30

# Email/Alerts (Optional)
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_HOST=smtp.gmail.com
ALERT_EMAIL_PORT=587
ALERT_EMAIL_USER=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_FROM=alerts@orchestration.local

# Debug Mode
DEBUG=false
VERBOSE=false
