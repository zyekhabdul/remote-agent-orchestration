{
  "name": "remote-agent-orchestration",
  "version": "1.0.0",
  "description": "Production-ready framework for managing distributed remote agents with secure command routing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern='\\.test\\.ts$'",
    "test:integration": "jest --testPathPattern='integration\\.test\\.ts$'",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t remote-agent-orchestration:latest .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "generate:docs": "swagger-jsdoc -d swaggerDef.js src/**/*.ts -o swagger.json"
  },
  "keywords": [
    "agent",
    "orchestration",
    "command-routing",
    "distributed-systems",
    "secure-communication"
  ],
  "author": "DevOps Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.13.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "express-async-errors": "^3.1.1",
    "dotenv": "^16.3.1",
    "pino": "^8.16.2",
    "pino-http": "^8.5.0",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "crypto-js": "^4.1.1",
    "node-cron": "^3.0.2",
    "axios": "^1.6.2",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.10",
    "@types/ws": "^8.5.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.16",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "prettier": "^3.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  }
}
